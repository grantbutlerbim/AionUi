# Supabase project settings (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Geocoding provider: "nominatim" (free, no key, rate-limited) or "google" or "mapbox"
VITE_GEOCODE_PROVIDER=nominatim
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_API_KEY=

# Used only by the Supabase Edge Function (supabase/functions/score-property).
# Set with: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=

# Reserved for future direct-mail integration (not called yet, no SMS is ever sent).
# LOB_API_KEY=
# POSTGRID_API_KEY=
